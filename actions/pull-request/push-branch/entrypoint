#!/bin/bash
set -euo pipefail
shopt -s inherit_errexit

function main() {
  local branch force token
  branch=""
  force=""
  token=""
  while [ "${#}" != 0 ]; do
    case "${1}" in
      --branch)
        branch="${2}"
        shift 2
        ;;

      --token)
        token="${2}"
        shift 2
        ;;

      --force)
        force="${2}"
        shift 2
        ;;

      "")
        shift
        ;;

      *)
        echo "unknown argument \"${1}\""
        exit 1
    esac
  done

  git config --global --add safe.directory "${GITHUB_WORKSPACE}"

  local git_auth=()
  if [[ -n "${token}" ]]; then
    local auth_header
    auth_header="AUTHORIZATION: basic $(printf '%s' "x-access-token:${token}" | base64 | tr -d '\n')"
    git_auth=(-c "http.https://github.com/.extraheader=${auth_header}")
  else
    echo "::warning::push-branch was called without a 'token' input; falling back to persisted git credentials. This fallback is deprecated and will be removed, at which point the token will be required. Please pass 'token: \${{ secrets.PAKETO_BOT_GITHUB_TOKEN }}'." >&2
  fi

  if [[ "${force}" == "true" ]]; then
    git "${git_auth[@]}" push origin "${branch}" --force-with-lease
  else
    git "${git_auth[@]}" push origin "${branch}"
  fi
}

main "${@:-}"
