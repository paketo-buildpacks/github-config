#!/bin/bash
set -euo pipefail
shopt -s inherit_errexit

function main() {
  local branch force token
  branch=""
  force=""
  token=""
  while [ "${#}" != 0 ]; do
    case "${1}" in
      --branch)
        branch="${2}"
        shift 2
        ;;

      --token)
        token="${2}"
        shift 2
        ;;

      --force)
        force="${2}"
        shift 2
        ;;

      "")
        shift
        ;;

      *)
        echo "unknown argument \"${1}\""
        exit 1
    esac
  done

  if [[ -z "${token}" ]]; then
    echo "a token is required to push a branch, but none was provided."
    echo "please set the 'token' input on the push-branch action."
    exit 1
  fi

  git config --global --add safe.directory "${GITHUB_WORKSPACE}"

  local auth_header
  auth_header="AUTHORIZATION: basic $(printf '%s' "x-access-token:${token}" | base64 | tr -d '\n')"

  if [[ "${force}" == "true" ]]; then
    git -c "http.https://github.com/.extraheader=${auth_header}" push origin "${branch}" --force-with-lease
  else
    git -c "http.https://github.com/.extraheader=${auth_header}" push origin "${branch}"
  fi
}

main "${@:-}"
